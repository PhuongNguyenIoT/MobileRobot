<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <!-- Gravity set to keep robot grounded and avoid floating/climbing artifacts -->
    <gravity>0 0 -9.81</gravity>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.0</mu>
                <mu2>0.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
            <specular>0.85 0.85 0.85 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Mê cung 5m x 5m dựa theo ảnh tham chiếu -->
    <model name="maze_5x5">
      <static>true</static>
      <pose>2.5 -1.25 0 0 0 1.5708</pose>
      <link name="walls">

      <collision name="c_left_outer"><pose>0 1.25 0.25 0 0 0</pose><geometry><box><size>0.04 2.5 0.5</size></box></geometry></collision>
        <visual    name="v_left_outer"><pose>0 1.25 0.25 0 0 0</pose><geometry><box><size>0.04 2.5 0.5</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual>

        <collision name="c_top_left"><pose>0.53125 2.5 0.25 0 0 0</pose><geometry><box><size>1.0625 0.04 0.5</size></box></geometry></collision>
        <visual    name="v_top_left"><pose>0.53125 2.5 0.25 0 0 0</pose><geometry><box><size>1.0625 0.04 0.5</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual>

        <collision name="c_left_short_top"><pose>0.25 2.0 0.25 0 0 0</pose><geometry><box><size>0.5 0.04 0.5</size></box></geometry></collision>
<visual    name="v_left_short_top"><pose>0.25 2.0 0.25 0 0 0</pose><geometry><box><size>0.5 0.04 0.5</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual>

        <collision name="c_left_inner_vert"><pose>1.0625 2.0 0.25 0 0 0</pose><geometry><box><size>0.04 1.0 0.5</size></box></geometry></collision>
        <visual    name="v_left_inner_vert"><pose>1.0625 2.0 0.25 0 0 0</pose><geometry><box><size>0.04 1.0 0.5</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual>

        <collision name="c_left_mid"><pose>0.78125 1.5 0.25 0 0 0</pose><geometry><box><size>0.5625 0.04 0.5</size></box></geometry></collision>
        <visual    name="v_left_mid"><pose>0.78125 1.5 0.25 0 0 0</pose><geometry><box><size>0.5625 0.04 0.5</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual>

        <collision name="c_left_long"><pose>0.53125 1.0 0.25 0 0 0</pose><geometry><box><size>1.0625 0.04 0.5</size></box></geometry></collision>
        <visual    name="v_left_long"><pose>0.53125 1.0 0.25 0 0 0</pose><geometry><box><size>1.0625 0.04 0.5</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual>

        <collision name="c_bottom_left"><pose>0.53125 0.0 0.25 0 0 0</pose><geometry><box><size>1.0625 0.04 0.5</size></box></geometry></collision>
        <visual    name="v_bottom_left"><pose>0.53125 0.0 0.25 0 0 0</pose><geometry><box><size>1.0625 0.04 0.5</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual>

        <collision name="c_bottom_mid"><pose>0.96875 0.5 0.25 0 0 0</pose><geometry><box><size>0.9375 0.04 0.5</size></box></geometry></collision>
        <visual    name="v_bottom_mid"><pose>0.96875 0.5 0.25 0 0 0</pose><geometry><box><size>0.9375 0.04 0.5</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual>

        <collision name="c_right_short_vert"><pose>1.4375 2.25 0.25 0 0 0</pose><geometry><box><size>0.04 0.5 0.5</size></box></geometry></collision>
        <visual    name="v_right_short_vert"><pose>1.4375 2.25 0.25 0 0 0</pose><geometry><box><size>0.04 0.5 0.5</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual>

        <collision name="c_top_right"><pose>1.96875 2.5 0.25 0 0 0</pose><geometry><box><size>1.0625 0.04 0.5</size></box></geometry></collision>
        <visual    name="v_top_right"><pose>1.96875 2.5 0.25 0 0 0</pose><geometry><box><size>1.0625 0.04 0.5</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual>

        <collision name="c_right_short_top"><pose>2.25 2.0 0.25 0 0 0</pose><geometry><box><size>0.5 0.04 0.5</size></box></geometry></collision>
<visual    name="v_right_short_top"><pose>2.25 2.0 0.25 0 0 0</pose><geometry><box><size>0.5 0.04 0.5</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual>

        <collision name="c_right_outer"><pose>2.5 1.25 0.25 0 0 0</pose><geometry><box><size>0.04 2.5 0.5</size></box></geometry></collision>
        <visual    name="v_right_outer"><pose>2.5 1.25 0.25 0 0 0</pose><geometry><box><size>0.04 2.5 0.5</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual>

        <collision name="c_right_block_left"><pose>1.4375 0.75 0.25 0 0 0</pose><geometry><box><size>0.04 1.5 0.5</size></box></geometry></collision>
        <visual    name="v_right_block_left"><pose>1.4375 0.75 0.25 0 0 0</pose><geometry><box><size>0.04 1.5 0.5</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual>

        <collision name="c_right_mid"><pose>1.71875 1.5 0.25 0 0 0</pose><geometry><box><size>0.5625 0.04 0.5</size></box></geometry></collision>
        <visual    name="v_right_mid"><pose>1.71875 1.5 0.25 0 0 0</pose><geometry><box><size>0.5625 0.04 0.5</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual>

        <collision name="c_right_inner_vert"><pose>2.0 1.0 0.25 0 0 0</pose><geometry><box><size>0.04 1.0 0.5</size></box></geometry></collision>
        <visual    name="v_right_inner_vert"><pose>2.0 1.0 0.25 0 0 0</pose><geometry><box><size>0.04 1.0 0.5</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual>

        <collision name="c_bottom_right"><pose>1.96875 0.0 0.25 0 0 0</pose><geometry><box><size>1.0625 0.04 0.5</size></box></geometry></collision>
        <visual    name="v_bottom_right"><pose>1.96875 0.0 0.25 0 0 0</pose><geometry><box><size>1.0625 0.04 0.5</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual>

      </link>
    </model>

  </world>
</sdf>